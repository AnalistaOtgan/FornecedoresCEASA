{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fornecedores-ceasa",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "TURSO_DATABASE_URL": "https://fornecedores-projetosotgan.aws-us-west-2.turso.io"
  },
  "routes": [
    {
      "pattern": "fornecedores.fmarechal.com",
      "custom_domain": true
    }
  ]
}
